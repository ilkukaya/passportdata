# Copy to .env for local builds. For the live site set these in Netlify:
# Site configuration → Environment variables (then trigger a deploy). Everything is optional:
# features without an ID are simply not rendered.

# Canonical site URL (no trailing slash). Change this when you connect your own domain.
SITE_URL=https://passportdata.netlify.app
PUBLIC_CONTACT_EMAIL=

# Google AdSense – publisher ID and (optional) manual ad unit slot IDs
PUBLIC_ADSENSE_CLIENT=            # ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT_TOP=
PUBLIC_ADSENSE_SLOT_IN_CONTENT=
PUBLIC_ADSENSE_SLOT_BOTTOM=

# Analytics (both free)
PUBLIC_GA4_ID=                    # G-XXXXXXXXXX
PUBLIC_CF_ANALYTICS_TOKEN=        # Cloudflare Web Analytics token

# Search engines
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_YANDEX_VERIFICATION=
PUBLIC_INDEXNOW_KEY=              # any 32-char hex string, e.g. from `openssl rand -hex 16`

# Affiliate programmes (free to join)
PUBLIC_AFF_SAFETYWING=            # SafetyWing referenceID
PUBLIC_AFF_AIRALO_URL=            # full Airalo referral link
PUBLIC_AFF_BOOKING_URL=           # full hotel affiliate link (Booking.com / Travelpayouts)
PUBLIC_AFF_IVISA_URL=             # full iVisa affiliate link

# Local development only: build route pages for 5 English passports instead of all 199
# PD_ROUTES=minimal
