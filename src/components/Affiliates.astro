---
import { getUI } from '../i18n';
import { AFFILIATES } from '../config/site';
interface Props { lang: string; visa?: boolean }
const { lang, visa = false } = Astro.props;
const ui = getUI(lang).affiliate;
const items = [
  visa && AFFILIATES.ivisa && { href: AFFILIATES.ivisa, title: ui.visaTitle, text: ui.visaText, icon: '🛂' },
  AFFILIATES.safetywing && {
    href: `https://safetywing.com/nomad-insurance?referenceID=${encodeURIComponent(AFFILIATES.safetywing)}&utm_source=${encodeURIComponent(AFFILIATES.safetywing)}&utm_medium=Ambassador`,
    title: ui.insuranceTitle, text: ui.insuranceText, icon: '🛡️',
  },
  AFFILIATES.airalo && { href: AFFILIATES.airalo, title: ui.esimTitle, text: ui.esimText, icon: '📶' },
  AFFILIATES.booking && { href: AFFILIATES.booking, title: ui.hotelTitle, text: ui.hotelText, icon: '🏨' },
].filter(Boolean) as { href: string; title: string; text: string; icon: string }[];
---
{items.length > 0 && (
  <section class="wrap mt-12" aria-labelledby="aff-title">
    <div class="flex items-baseline justify-between mb-4">
      <h2 id="aff-title" class="section-title !mb-0">{ui.title}</h2>
      <span class="text-xs uppercase tracking-wide text-slate-400">{ui.sponsored}</span>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((it) => (
        <a href={it.href} target="_blank" rel="sponsored noopener" class="card p-5 hover:shadow-md transition-shadow group">
          <span class="text-2xl" aria-hidden="true">{it.icon}</span>
          <p class="mt-2 font-semibold text-slate-900 group-hover:text-indigo-700">{it.title}</p>
          <p class="text-sm text-slate-600 mt-1">{it.text}</p>
          <span class="mt-3 inline-block text-sm font-semibold text-indigo-700">{ui.cta} →</span>
        </a>
      ))}
    </div>
  </section>
)}
