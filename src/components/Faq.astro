---
import type { QA } from '../lib/schema';
interface Props { title: string; items: QA[] }
const { title, items } = Astro.props;
---
<section class="wrap mt-12" id="faq">
  <h2 class="section-title">{title}</h2>
  <div class="card divide-y divide-slate-200">
    {items.map((it, i) => (
      <details class="group p-5" open={i === 0}>
        <summary class="flex cursor-pointer items-start justify-between gap-4 font-semibold text-slate-900">
          <h3 class="text-base">{it.q}</h3>
          <span aria-hidden="true" class="text-slate-400 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
        </summary>
        <p class="mt-3 text-slate-700 leading-relaxed">{it.a}</p>
      </details>
    ))}
  </div>
</section>
