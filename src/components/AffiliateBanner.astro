---
import { useTranslations, type Lang } from '../utils/i18n';

interface Props {
  lang: string;
  showIvisa?: boolean;
}

const { lang, showIvisa = false } = Astro.props;
const t = useTranslations(lang as Lang);

const affiliates = [
  {
    label: t('affiliate.insurance_label'),
    title: t('affiliate.insurance_title'),
    desc: t('affiliate.insurance_desc'),
    cta: t('affiliate.insurance_cta'),
    href: 'https://safetywing.com/nomad-insurance?referenceID=REFID',
    icon: '🛡️',
    color: 'from-emerald-500 to-green-600',
  },
  {
    label: t('affiliate.esim_label'),
    title: t('affiliate.esim_title'),
    desc: t('affiliate.esim_desc'),
    cta: t('affiliate.esim_cta'),
    href: 'https://ref.airalo.com/REFID',
    icon: '📱',
    color: 'from-blue-500 to-indigo-600',
  },
  {
    label: t('affiliate.hotel_label'),
    title: t('affiliate.hotel_title'),
    desc: t('affiliate.hotel_desc'),
    cta: t('affiliate.hotel_cta'),
    href: 'https://tp.media/click?shmarker=MARKER&promo_id=4132&source_type=customlink&type=click&custom_url=booking.com',
    icon: '🏨',
    color: 'from-orange-500 to-red-600',
  },
];
---

<section class="container mx-auto px-4 py-8">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {affiliates.map(item => (
      <a
        href={item.href}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="block bg-white rounded-xl shadow-sm border hover:shadow-md transition-shadow overflow-hidden group"
      >
        <div class={`bg-gradient-to-r ${item.color} px-4 py-1.5 text-xs font-bold text-white uppercase tracking-wide`}>
          {item.label}
        </div>
        <div class="p-4">
          <div class="flex items-start gap-3">
            <span class="text-2xl">{item.icon}</span>
            <div>
              <h3 class="font-bold text-gray-900 group-hover:text-indigo-600 transition-colors">{item.title}</h3>
              <p class="text-sm text-gray-500 mt-1">{item.desc}</p>
              <span class="inline-block mt-3 text-sm font-semibold text-indigo-600 group-hover:text-indigo-800">
                {item.cta} →
              </span>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>

  {showIvisa && (
    <div class="mt-6 bg-gradient-to-r from-purple-600 to-indigo-700 rounded-xl p-6 text-white text-center">
      <h3 class="text-xl font-bold mb-2">🪪 {t('category_pages.apply_visa')}</h3>
      <p class="text-purple-200 mb-4 text-sm">{t('category_pages.ivisa_desc')}</p>
      <a
        href="https://ivisa.com/?ref=REFID"
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="inline-block bg-white text-purple-700 font-bold px-6 py-3 rounded-lg hover:bg-purple-50 transition-colors"
      >
        Apply Now on iVisa →
      </a>
    </div>
  )}
</section>
