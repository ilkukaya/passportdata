---
interface Props {
  slot_id: string;
  format?: string;
}
const { slot_id, format = 'auto' } = Astro.props;
---

<div class="container mx-auto px-4 my-6">
  <div class="bg-gray-100 rounded-lg p-2 text-center min-h-[90px] flex items-center justify-center">
    <ins
      class="adsbygoogle"
      style="display:block"
      data-ad-client="ca-pub-ADSENSE_PUB_ID"
      data-ad-slot={slot_id}
      data-ad-format={format}
      data-full-width-responsive="true"
    ></ins>
    <script>
      (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
  </div>
</div>
