---
import type { Crumb } from '../lib/schema';
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav aria-label="Breadcrumb" class="wrap pt-4 text-sm text-slate-500">
  <ol class="flex flex-wrap items-center gap-1.5">
    {items.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-slate-300 rtl:rotate-180">›</span>}
        {c.path ? <a href={c.path} class="hover:text-indigo-700">{c.name}</a> : <span aria-current="page" class="text-slate-700">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
