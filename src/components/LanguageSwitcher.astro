---
interface Props {
  lang: string;
  alternateLinks?: Record<string, string>;
}
const { lang, alternateLinks } = Astro.props;

const LANGS = [
  { code: 'en', name: 'EN', flag: '🇬🇧' },
  { code: 'tr', name: 'TR', flag: '🇹🇷' },
  { code: 'es', name: 'ES', flag: '🇪🇸' },
  { code: 'ar', name: 'AR', flag: '🇸🇦' },
  { code: 'pt', name: 'PT', flag: '🇧🇷' },
  { code: 'fr', name: 'FR', flag: '🇫🇷' },
];
---

<div class="flex items-center gap-1">
  {LANGS.map(l => {
    const href = alternateLinks?.[l.code] || `/${l.code}/`;
    const isActive = l.code === lang;
    return (
      <a
        href={href}
        class:list={[
          'px-2 py-1 rounded text-xs font-medium transition-colors',
          isActive ? 'bg-indigo-100 text-indigo-700' : 'text-gray-500 hover:bg-gray-100 hover:text-gray-700'
        ]}
        title={l.name}
      >
        {l.flag}
      </a>
    );
  })}
</div>
