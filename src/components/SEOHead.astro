---
interface Props {
  title: string;
  description: string;
  lang: string;
  alternateLinks?: Record<string, string>;
  canonicalUrl?: string;
  rtl?: boolean;
}
const { title, description, lang, alternateLinks, canonicalUrl, rtl } = Astro.props;
const ADSENSE_ID = 'ca-pub-ADSENSE_PUB_ID';
---

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl || Astro.url.href} />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  {alternateLinks && Object.entries(alternateLinks).map(([hLang, href]) => (
    <link rel="alternate" hreflang={hLang} href={`https://passportdata.netlify.app${href}`} />
  ))}
  {alternateLinks?.en && (
    <link rel="alternate" hreflang="x-default" href={`https://passportdata.netlify.app${alternateLinks.en}`} />
  )}

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang} />
  <meta property="og:site_name" content="PassportData" />
  <meta property="og:image" content={`https://passportdata.netlify.app/og-image-${lang}.png`} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "PassportData",
    "url": "https://passportdata.netlify.app",
    "description": description,
    "inLanguage": lang
  })} />

  <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_ID}`} crossorigin="anonymous"></script>
  <script defer data-domain="passportdata.netlify.app" src="https://plausible.io/js/script.js"></script>
</head>
