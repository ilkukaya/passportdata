---
import { useTranslations, getVisaStatusDot, type Lang } from '../utils/i18n';

interface Props {
  stats: {
    visa_free: number;
    visa_on_arrival: number;
    e_visa: number;
    visa_required: number;
    total: number;
  };
  lang: string;
  countryCode: string;
}

const { stats, lang, countryCode } = Astro.props;
const t = useTranslations(lang as Lang);

const cards = [
  { key: 'visa_free', count: stats.visa_free, color: 'border-green-500', bg: 'bg-green-50', text: 'text-green-700', dot: 'bg-green-500' },
  { key: 'visa_on_arrival', count: stats.visa_on_arrival, color: 'border-yellow-500', bg: 'bg-yellow-50', text: 'text-yellow-700', dot: 'bg-yellow-500' },
  { key: 'e_visa', count: stats.e_visa, color: 'border-blue-500', bg: 'bg-blue-50', text: 'text-blue-700', dot: 'bg-blue-500' },
  { key: 'visa_required', count: stats.visa_required, color: 'border-red-500', bg: 'bg-red-50', text: 'text-red-700', dot: 'bg-red-500' },
];
---

<section class="container mx-auto px-4 -mt-6 relative z-10">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {cards.map(card => (
      <div class={`stat-card border-t-4 ${card.color} ${card.bg}`}>
        <div class={`flex items-center justify-center gap-2 mb-1`}>
          <span class={`w-2.5 h-2.5 rounded-full ${card.dot}`}></span>
          <span class={`text-xs font-medium ${card.text} uppercase tracking-wide`}>
            {t(`stats.${card.key}`)}
          </span>
        </div>
        <div class={`text-3xl font-bold ${card.text}`}>{card.count}</div>
      </div>
    ))}
  </div>
</section>
