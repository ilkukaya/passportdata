---
import countries from '../data/countries.json';

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const countryList = Object.entries(countries as Record<string, any>)
  .map(([code, data]) => ({
    code,
    name: data.names?.[lang] || data.names?.en || code,
    slug: data.slugs?.[lang] || data.slugs?.en || code.toLowerCase(),
    flag_url: data.flag_url,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, lang));
---

<div class="mb-4">
  <input
    type="text"
    id="country-selector-search"
    placeholder="Search..."
    class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-indigo-300 focus:outline-none"
  />
  <div id="country-selector-dropdown" class="hidden mt-1 bg-white rounded-xl shadow-xl max-h-60 overflow-y-auto border">
  </div>
</div>

<script define:vars={{ countryList, lang }}>
  const input = document.getElementById('country-selector-search');
  const dropdown = document.getElementById('country-selector-dropdown');

  input.addEventListener('input', () => {
    const q = input.value.toLowerCase();
    if (!q) { dropdown.classList.add('hidden'); return; }
    const results = countryList
      .filter(c => c.name.toLowerCase().includes(q))
      .slice(0, 10);
    dropdown.innerHTML = results.map(c =>
      `<a href="/${lang}/${c.slug}/" class="flex items-center gap-3 px-4 py-2 hover:bg-indigo-50 transition-colors">
        <img src="${c.flag_url}" class="w-7 h-5 object-cover rounded" alt="${c.name}" />
        <span class="text-gray-800 font-medium">${c.name}</span>
      </a>`
    ).join('');
    dropdown.classList.remove('hidden');
  });

  document.addEventListener('click', (e) => {
    if (!input.contains(e.target) && !dropdown.contains(e.target)) {
      dropdown.classList.add('hidden');
    }
  });
</script>
