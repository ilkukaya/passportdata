---
import { ADSENSE_CLIENT, ADSENSE_SLOTS } from '../config/site';
interface Props { slot: keyof typeof ADSENSE_SLOTS }
const id = ADSENSE_SLOTS[Astro.props.slot];
---
{ADSENSE_CLIENT && id && (
  <div class="wrap my-8 min-h-[100px]" aria-hidden="true">
    <ins class="adsbygoogle block" style="display:block" data-ad-client={ADSENSE_CLIENT} data-ad-slot={id} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
