---
/** Stacked bar showing how 198 destinations (or passports) split by requirement. */
import { getUI, num } from '../i18n';
import { STATUSES, type Counts } from '../lib/data';
interface Props { lang: string; counts: Counts; links?: boolean }
const { lang, counts, links = true } = Astro.props;
const ui = getUI(lang);
const total = STATUSES.reduce((n, s) => n + counts[s], 0);
const shown = STATUSES.filter((s) => counts[s] > 0);
---
<div>
  <div class="flex h-3 w-full overflow-hidden rounded-full bg-sunken" role="img"
       aria-label={shown.map((s) => `${ui.status[s]}: ${counts[s]}`).join(', ')}>
    {shown.map((s) => <span class={`bar-${s} h-full`} style={`width:${(counts[s] / total) * 100}%`}></span>)}
  </div>
  <ul class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-4 gap-y-3">
    {shown.map((s) => {
      const inner = (
        <>
          <span class="flex items-start gap-2 text-xs leading-snug text-muted"><span class={`dot-${s} mt-1 h-2 w-2 shrink-0 rounded-full`}></span>{ui.status[s]}</span>
          <span class="num mt-auto block pt-1 text-2xl font-semibold text-ink">{num(lang, counts[s])}</span>
        </>
      );
      return <li class="flex flex-col">{links ? <a href={`#${s}`} class="flex flex-1 flex-col hover:opacity-80">{inner}</a> : inner}</li>;
    })}
  </ul>
</div>
