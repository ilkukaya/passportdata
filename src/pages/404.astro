---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>404 — Page Not Found | PassportData</title>
  <meta name="description" content="The page you are looking for could not be found." />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
</head>
<body class="min-h-screen bg-gradient-to-br from-slate-900 via-blue-950 to-indigo-950 flex items-center justify-center p-4">
  <div class="text-center max-w-md">
    <div class="text-7xl mb-4">🛂</div>
    <h1 class="text-6xl font-bold text-white mb-4">404</h1>
    <p class="text-xl text-blue-200 mb-2">Page Not Found</p>
    <p class="text-blue-300/70 text-sm mb-8">The page you are looking for might have been moved or doesn't exist.</p>
    <a
      href="/"
      class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-bold px-8 py-3 rounded-xl text-lg transition-colors"
    >
      Go Home
    </a>
  </div>
</body>
</html>
