---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Flag from '../../components/Flag.astro';
import AdSlot from '../../components/AdSlot.astro';
import Icon from '../../components/Icon.astro';
import { LANG_CODES, getUI } from '../../i18n';
import { SCHENGEN, SITE_URL } from '../../config/site';
import { countryName, homePath, toolPath, alternatesFor, sortByName, visitPath } from '../../lib/data';
import { webPage, breadcrumbList, faqPage } from '../../lib/schema';

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const ui = getUI(lang);
const s = ui.schengen;
const path = toolPath(lang, 'schengen-calculator');
const url = `${SITE_URL}${path}`;
const title = s.title;
const description = s.description;
const crumbs = [{ name: ui.nav.home, path: homePath(lang) }, { name: ui.nav.schengen }];
const faq = [{ q: s.howTitle, a: s.how.join(' ') }];
const jsonLd = [
  webPage({ url, name: title, description, lang, crumbs, type: 'WebApplication' }),
  breadcrumbList(url, crumbs),
  faqPage(url, faq),
];
const strings = { used: s.used, remaining: s.remaining, maxStay: s.maxStay, over: s.over, invalid: s.invalid, entry: s.entry, exit: s.exit, remove: s.remove };
---

<BaseLayout {lang} {title} {description} {path} alternates={alternatesFor((l) => toolPath(l, 'schengen-calculator'))} {jsonLd}>
  <Breadcrumbs items={crumbs} />
  <section class="wrap mt-5">
    <h1 class="text-3xl md:text-[2.6rem] leading-tight">{s.h1}</h1>
    <p class="mt-3 max-w-3xl text-lg text-muted">{s.intro}</p>
  </section>

  <section class="wrap mt-8 grid gap-8 lg:grid-cols-[1.5fr_1fr]">
    <div class="rounded-xl border border-line bg-surface">
      <div class="p-5 sm:p-6">
        <h2 class="text-lg mb-4">{s.stays}</h2>
        <div id="stays" class="space-y-3"></div>
        <button type="button" id="add-stay" class="btn-quiet mt-3 -ms-2.5 font-semibold text-brand">+ {s.add}</button>
      </div>
      <div class="border-t border-line p-5 sm:p-6">
        <label class="block max-w-xs">
          <span class="eyebrow mb-1.5 block">{s.checkDate}</span>
          <input type="date" id="check-date" class="field" />
        </label>
        <button type="button" id="calc" class="btn mt-5 w-full sm:w-auto">{s.calculate}<Icon name="arrow" size={18} class="rtl:rotate-180" /></button>
      </div>
      <div id="result" class="hidden border-t border-line p-5 sm:p-6" aria-live="polite">
        <div class="grid grid-cols-2 gap-6">
          <div><p id="r-used-label" class="text-sm text-muted"></p><p id="r-used" class="num mt-1 text-4xl font-semibold"></p></div>
          <div><p id="r-rem-label" class="text-sm text-muted"></p><p id="r-rem" class="num mt-1 text-4xl font-semibold"></p></div>
        </div>
        <div class="mt-5 h-2 overflow-hidden rounded-full bg-sunken"><div id="r-bar" class="h-full rounded-full bg-brand transition-all" style="width:0"></div></div>
        <p id="r-msg" class="mt-4 font-medium"></p>
      </div>
    </div>
    <aside class="space-y-6">
      <div>
        <h2 class="text-lg mb-3">{s.membersTitle} <span class="num font-sans text-sm font-normal text-muted">({SCHENGEN.length})</span></h2>
        <ul class="grid grid-cols-2 gap-x-6 border-t border-line text-sm">
          {sortByName(SCHENGEN, lang).map((c) => (
            <li><a href={visitPath(lang, c)} class="crow !py-2"><Flag code={c} /><span class="cname">{countryName(c, lang)}</span></a></li>
          ))}
        </ul>
      </div>
      <p class="flex gap-2 text-xs text-muted"><Icon name="info" size={16} />{s.disclaimer}</p>
    </aside>
  </section>

  <section class="wrap mt-14 max-w-3xl prose-text">
    <h2 class="!mt-0">{s.howTitle}</h2>
    {s.how.map((para) => <p>{para}</p>)}
  </section>

  <AdSlot slot="bottom" />

  <template id="stay-tpl">
    <div class="stay grid grid-cols-[1fr_1fr_auto] items-end gap-3">
      <label class="block"><span class="mb-1 block text-xs text-muted">{s.entry}</span><input type="date" class="field !py-2 entry" /></label>
      <label class="block"><span class="mb-1 block text-xs text-muted">{s.exit}</span><input type="date" class="field !py-2 exit" /></label>
      <button type="button" class="remove btn-quiet !py-2.5" aria-label={s.remove}><Icon name="close" size={18} /></button>
    </div>
  </template>
  <script type="application/json" id="sc-data" set:html={JSON.stringify({ lang, strings })} />
</BaseLayout>

<script>
  const { lang, strings } = JSON.parse(document.getElementById('sc-data')!.textContent!);
  const DAY = 86_400_000;
  const toDay = (v: string) => Math.floor(Date.parse(`${v}T00:00:00Z`) / DAY);
  const fromDay = (d: number) => new Date(d * DAY);
  const fmtDate = (d: number) => new Intl.DateTimeFormat(lang, { dateStyle: 'medium', timeZone: 'UTC' }).format(fromDay(d));
  const iso = (d: number) => fromDay(d).toISOString().slice(0, 10);
  // Tailwind classes built at runtime: text-emerald-600 text-amber-600 text-rose-600 bg-emerald-500 bg-amber-500 bg-rose-500
  const fill = (t: string, v: Record<string, string | number>) => t.replace(/\{(\w+)\}/g, (m, k) => (k in v ? String(v[k]) : m));
  const staysEl = document.getElementById('stays')!;
  const tpl = document.getElementById('stay-tpl') as HTMLTemplateElement;
  const checkInput = document.getElementById('check-date') as HTMLInputElement;
  const STORE = 'pd_schengen_v1';

  function addStay(entry = '', exit = '') {
    const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    (node.querySelector('.entry') as HTMLInputElement).value = entry;
    (node.querySelector('.exit') as HTMLInputElement).value = exit;
    node.querySelector('.remove')!.addEventListener('click', () => { node.remove(); if (!staysEl.children.length) addStay(); });
    staysEl.append(node);
  }

  /** Number of days in the set within the 180-day window ending on `day` (inclusive). */
  const windowCount = (days: Set<number>, day: number) => {
    let n = 0;
    for (let d = day - 179; d <= day; d++) if (days.has(d)) n++;
    return n;
  };

  function calculate() {
    const days = new Set<number>();
    const saved: [string, string][] = [];
    staysEl.querySelectorAll('.stay').forEach((row) => {
      const e = (row.querySelector('.entry') as HTMLInputElement).value;
      const x = (row.querySelector('.exit') as HTMLInputElement).value;
      if (!e || !x || toDay(x) < toDay(e)) return;
      saved.push([e, x]);
      for (let d = toDay(e); d <= toDay(x); d++) days.add(d);
    });
    const result = document.getElementById('result')!;
    const msg = document.getElementById('r-msg')!;
    result.classList.remove('hidden');
    if (!saved.length) {
      msg.textContent = strings.invalid;
      return;
    }
    try { localStorage.setItem(STORE, JSON.stringify(saved)); } catch {}
    const check = checkInput.value ? toDay(checkInput.value) : Math.floor(Date.now() / DAY);
    // Days already used in the window that ends the day before the check date.
    const used = windowCount(days, check - 1);
    const remaining = Math.max(0, 90 - used);
    let stay = 0;
    const sim = new Set(days);
    while (stay < 90) {
      const d = check + stay;
      const had = sim.has(d);
      sim.add(d);
      if (windowCount(sim, d) > 90) { if (!had) sim.delete(d); break; }
      stay++;
    }
    const date = fmtDate(check);
    document.getElementById('r-used-label')!.textContent = fill(strings.used, { date: fmtDate(check - 1) });
    document.getElementById('r-used')!.textContent = `${used} / 90`;
    document.getElementById('r-rem-label')!.textContent = fill(strings.remaining, { date });
    const rem = document.getElementById('r-rem')!;
    rem.textContent = String(remaining);
    const tone = stay > 30 ? 'emerald' : stay > 0 ? 'amber' : 'rose';
    rem.className = `num mt-1 text-4xl font-semibold text-${tone}-600`;
    const bar = document.getElementById('r-bar')!;
    bar.style.width = `${Math.min(100, (used / 90) * 100)}%`;
    bar.className = `h-full rounded-full transition-all bg-${tone}-500`;
    msg.textContent = used > 90
      ? fill(strings.over, { date, n: used - 90 })
      : fill(strings.maxStay, { date, n: stay, until: fmtDate(check + Math.max(stay, 1) - 1) });
  }

  let restored: [string, string][] = [];
  try { restored = JSON.parse(localStorage.getItem(STORE) || '[]'); } catch {}
  if (restored.length) restored.forEach(([e, x]) => addStay(e, x)); else addStay();
  checkInput.value = iso(Math.floor(Date.now() / DAY));
  document.getElementById('add-stay')!.addEventListener('click', () => addStay());
  document.getElementById('calc')!.addEventListener('click', calculate);
</script>
