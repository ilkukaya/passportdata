---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountrySearch from '../../components/CountrySearch.astro';
import Flag from '../../components/Flag.astro';
import AdSlot from '../../components/AdSlot.astro';
import { LANG_CODES, getUI, fmt, num, formatDate } from '../../i18n';
import { POPULAR_DESTINATIONS, POPULAR_PASSPORTS, SITE_URL } from '../../config/site';
import {
  CODES, RANKING, DATA_UPDATED, countryName, passportPath, visitPath, homePath, toolPath, alternatesFor, sortByName, rankOf,
} from '../../lib/data';
import { webPage, dataset } from '../../lib/schema';

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const ui = getUI(lang);
const year = new Date().getUTCFullYear();
const path = homePath(lang);
const title = fmt(ui.meta.homeTitle, { year });
const description = ui.meta.homeDescription;
const top = RANKING.slice(0, 10);
const tools = [
  { href: toolPath(lang, 'passport-ranking'), title: ui.nav.ranking, text: ui.home.rankingCard, icon: '🏆' },
  { href: toolPath(lang, 'compare'), title: ui.nav.compare, text: ui.home.compareCard, icon: '⚖️' },
  { href: toolPath(lang, 'schengen-calculator'), title: ui.nav.schengen, text: ui.home.schengenCard, icon: '🗓️' },
];
const jsonLd = [
  webPage({ url: `${SITE_URL}${path}`, name: title, description, lang }),
  dataset(lang, 'PassportData – global visa requirements', ui.home.aboutText),
];
---

<BaseLayout {lang} {title} {description} {path} alternates={alternatesFor(homePath)} xDefault="/" {jsonLd}>
  <section class="bg-gradient-to-br from-indigo-950 via-indigo-900 to-sky-900 text-white">
    <div class="wrap py-14 md:py-20 text-center">
      <h1 class="!text-white text-3xl md:text-5xl mb-4">{ui.home.h1}</h1>
      <p class="text-indigo-100 text-lg max-w-2xl mx-auto mb-8">{ui.home.lead}</p>
      <div class="max-w-xl mx-auto"><CountrySearch {lang} dark placeholder={ui.common.selectPassport} /></div>
      <dl class="mt-10 flex justify-center gap-8 md:gap-14 text-indigo-100">
        <div class="flex flex-col-reverse"><dt class="text-sm">{ui.home.statPassports}</dt><dd class="text-2xl font-bold text-white">{num(lang, CODES.length)}</dd></div>
        <div class="flex flex-col-reverse"><dt class="text-sm">{ui.home.statRoutes}</dt><dd class="text-2xl font-bold text-white">{num(lang, CODES.length * (CODES.length - 1))}</dd></div>
        <div class="flex flex-col-reverse"><dt class="text-sm">{ui.home.statLanguages}</dt><dd class="text-2xl font-bold text-white">{num(lang, LANG_CODES.length)}</dd></div>
      </dl>
      <p class="mt-6 text-xs text-indigo-200">{fmt(ui.common.updated, { date: formatDate(lang, DATA_UPDATED) })}</p>
    </div>
  </section>

  <section class="wrap mt-12">
    <h2 class="section-title">{ui.common.popularPassports}</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
      {POPULAR_PASSPORTS.map((code) => (
        <li>
          <a href={passportPath(lang, code)} class="card flex flex-col items-center gap-2 p-4 text-center hover:shadow-md transition-shadow h-full">
            <Flag code={code} size="md" />
            <span class="text-sm font-semibold text-slate-800">{countryName(code, lang)}</span>
            <span class="text-xs text-slate-500">#{rankOf(code).rank} · {num(lang, rankOf(code).score)}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <AdSlot slot="top" />

  <section class="wrap mt-12 grid gap-8 lg:grid-cols-2">
    <div>
      <h2 class="section-title">{ui.home.strongest}</h2>
      <ol class="card divide-y divide-slate-100">
        {top.map((e) => (
          <li>
            <a href={passportPath(lang, e.code)} class="flex items-center gap-3 px-4 py-3 hover:bg-slate-50">
              <span class="w-8 text-slate-500 font-semibold">#{e.rank}</span>
              <Flag code={e.code} />
              <span class="flex-1 font-medium">{countryName(e.code, lang)}</span>
              <span class="text-sm font-semibold text-indigo-700">{num(lang, e.score)}</span>
            </a>
          </li>
        ))}
      </ol>
      <a href={toolPath(lang, 'passport-ranking')} class="inline-block mt-3 text-sm font-semibold text-indigo-700 hover:underline">{ui.common.viewAll} →</a>
    </div>
    <div>
      <h2 class="section-title">{ui.home.popularDestinations}</h2>
      <ul class="grid grid-cols-2 gap-2">
        {POPULAR_DESTINATIONS.slice(0, 20).map((code) => (
          <li>
            <a href={visitPath(lang, code)} class="tile-sm">
              <Flag code={code} /><span class="truncate text-sm font-medium">{countryName(code, lang)}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap mt-12">
    <h2 class="section-title">{ui.home.tools}</h2>
    <div class="grid gap-4 md:grid-cols-3">
      {tools.map((t) => (
        <a href={t.href} class="card p-6 hover:shadow-md transition-shadow">
          <span class="text-3xl" aria-hidden="true">{t.icon}</span>
          <h3 class="mt-3 text-lg">{t.title}</h3>
          <p class="text-slate-600 text-sm mt-1">{t.text}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap mt-12">
    <div class="card p-6 md:p-8">
      <h2 class="section-title">{ui.home.aboutTitle}</h2>
      <p class="text-slate-700 leading-relaxed max-w-4xl">{ui.home.aboutText}</p>
    </div>
  </section>

  <section class="wrap mt-12">
    <h2 class="section-title">{ui.common.allPassports}</h2>
    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-4 gap-y-1 text-sm">
      {sortByName(CODES, lang).map((code) => (
        <li><a href={passportPath(lang, code)} class="flex items-center gap-2 py-1.5 hover:text-indigo-700"><Flag code={code} /><span class="truncate">{countryName(code, lang)}</span></a></li>
      ))}
    </ul>
  </section>
</BaseLayout>
