---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TripChecker from '../../components/TripChecker.astro';
import { LANG_CODES, getUI } from '../../i18n';
import { homePath } from '../../lib/data';

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: string };
const ui = getUI(lang);
---
<BaseLayout {lang} title={`${ui.notFound.title} | PassportData`} description={ui.notFound.text} path={`/${lang}/404/`} noindex>
  <section class="wrap max-w-3xl py-16">
    <p class="font-mono text-sm tracking-[0.2em] text-stamp">404</p>
    <h1 class="mt-3 text-4xl">{ui.notFound.title}</h1>
    <p class="mt-3 text-lg text-muted">{ui.notFound.text}</p>
    <div class="mt-8"><TripChecker {lang} /></div>
    <a href={homePath(lang)} class="link mt-8 inline-block font-semibold">{ui.notFound.home}</a>
  </section>
</BaseLayout>
