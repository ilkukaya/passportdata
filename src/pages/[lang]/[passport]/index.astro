---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Flag from '../../../components/Flag.astro';
import StatusSummary from '../../../components/StatusSummary.astro';
import CountryGroups from '../../../components/CountryGroups.astro';
import Faq from '../../../components/Faq.astro';
import AdSlot from '../../../components/AdSlot.astro';
import Affiliates from '../../../components/Affiliates.astro';
import { LANG_CODES, getUI, fmt, num, formatDate, list } from '../../../i18n';
import { POPULAR_DESTINATIONS, SCHENGEN, SITE_URL } from '../../../config/site';
import {
  CODES, DATA_UPDATED, OPEN_STATUSES, countryName, passportPath, homePath, pairPath, visitPath, toolPath, alternatesFor,
  outboundCounts, outboundGroups, rankOf, requirement,
} from '../../../lib/data';
import { webPage, breadcrumbList, faqPage, type QA } from '../../../lib/schema';

export function getStaticPaths() {
  return LANG_CODES.flatMap((lang) => CODES.map((code) => ({ params: { lang, passport: passportPath(lang, code).split('/')[2] }, props: { code } })));
}

const { lang } = Astro.params as { lang: string };
const { code } = Astro.props;
const ui = getUI(lang);
const p = ui.passport;
const year = new Date().getUTCFullYear();
const country = countryName(code, lang);
const counts = outboundCounts(code);
const rank = rankOf(code);
const date = formatDate(lang, DATA_UPDATED);
const vars = {
  country, year, date, rank: rank.rank,
  mobility: num(lang, counts.open), vf: num(lang, counts.visa_free), voa: num(lang, counts.visa_on_arrival),
  eta: num(lang, counts.eta), ev: num(lang, counts.e_visa), vr: num(lang, counts.visa_required),
};
const path = passportPath(lang, code);
const url = `${SITE_URL}${path}`;
const title = fmt(p.title, vars);
const description = fmt(p.description, vars);

const popularOpen = POPULAR_DESTINATIONS.filter((d) => d !== code && OPEN_STATUSES.includes(requirement(code, d)?.status as any)).slice(0, 8);
const faq: QA[] = [
  { q: fmt(p.faq.q1, vars), a: fmt(p.faq.a1, vars) },
  { q: fmt(p.faq.q2, vars), a: fmt(p.faq.a2, vars) },
];
if (!SCHENGEN.includes(code) && !['IE', 'CY'].includes(code)) {
  const schengen = requirement(code, 'DE')?.status;
  faq.push({ q: fmt(p.faq.q3, vars), a: fmt(schengen && OPEN_STATUSES.includes(schengen) ? p.faq.a3no : p.faq.a3yes, vars) });
}
if (popularOpen.length) {
  faq.push({ q: fmt(p.faq.q4, vars), a: fmt(p.faq.a4, { ...vars, list: list(lang, popularOpen.map((d) => countryName(d, lang))) }) });
}
faq.push({ q: fmt(p.faq.q5, vars), a: fmt(p.faq.a5, vars) });

const crumbs = [{ name: ui.nav.home, path: homePath(lang) }, { name: country }];
const jsonLd = [
  webPage({ url, name: title, description, lang, crumbs, about: { '@type': 'Country', name: countryName(code, 'en') } }),
  breadcrumbList(url, crumbs),
  faqPage(url, faq),
];
---

<BaseLayout {lang} {title} {description} {path} alternates={alternatesFor((l) => passportPath(l, code))} {jsonLd}>
  <Breadcrumbs items={crumbs} />

  <section class="wrap mt-4">
    <div class="card p-6 md:p-8">
      <div class="flex flex-col md:flex-row md:items-center gap-5">
        <Flag code={code} size="xl" eager />
        <div class="flex-1">
          <h1 class="text-2xl md:text-4xl">{fmt(p.h1, vars)}</h1>
          <p class="mt-2 text-sm text-slate-500">{fmt(ui.common.updated, { date })}</p>
        </div>
        <a href={`${toolPath(lang, 'passport-ranking')}#${code.toLowerCase()}`} class="rounded-2xl bg-indigo-50 px-5 py-3 text-center hover:bg-indigo-100">
          <span class="block text-xs font-semibold uppercase tracking-wide text-indigo-700">{ui.common.rank}</span>
          <span class="block text-3xl font-bold text-indigo-900">#{rank.rank}</span>
        </a>
      </div>
      <p class="mt-6 text-slate-700 leading-relaxed text-lg" data-answer>{fmt(p.summary, vars)}</p>
      <p class="mt-2 text-slate-600">{fmt(p.rankLine, vars)}</p>
      <p class="mt-2 text-sm text-slate-500" title={p.mobilityHint}>
        {p.mobilityScore}: <strong class="text-slate-800">{vars.mobility}</strong> — {p.mobilityHint}
      </p>
    </div>
  </section>

  <section class="wrap mt-6"><StatusSummary {lang} {counts} /></section>

  <AdSlot slot="top" />

  <section class="wrap mt-10" aria-label={fmt(p.tableTitle, vars)}>
    <CountryGroups
      {lang}
      groups={outboundGroups(code)}
      heading={(s) => fmt(p.lists[s], vars)}
      href={(d) => pairPath(lang, code, d)}
      days={(d) => requirement(code, d)?.days ?? null}
    />
  </section>

  <AdSlot slot="inContent" />

  <Faq title={ui.common.faq} items={faq} />

  <Affiliates {lang} visa={counts.e_visa + counts.eta > 0} />

  <section class="wrap mt-12">
    <p class="text-sm text-slate-500 max-w-4xl">{ui.common.officialCheck}</p>
    <p class="mt-3 text-sm"><a class="text-indigo-700 font-semibold hover:underline" href={visitPath(lang, code)}>{fmt(ui.visit.link, { destination: country })} →</a></p>
  </section>

  <AdSlot slot="bottom" />
</BaseLayout>
