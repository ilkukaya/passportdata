---
import countries from '../../data/countries.json';
import visaMatrix from '../../data/visa_matrix.json';
import { SUPPORTED_LANGS, useTranslations, getToolPageAlternateLinks, isRTL, type Lang } from '../../utils/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
const currentYear = new Date().getFullYear();
const alternateLinks = getToolPageAlternateLinks('compare');

const title = t('seo.compare_title', { year: String(currentYear) });
const description = t('seo.compare_description');

const breadcrumbs = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.compare') },
];

const countryList = Object.entries(countries as Record<string, any>)
  .filter(([code]) => (visaMatrix as any).data[code])
  .map(([code, data]) => ({
    code,
    name: data.names?.[lang] || data.names?.en || code,
    flag_url: data.flag_url,
  }))
  .sort((a, b) => a.name.localeCompare(b.name, lang));

const matrixData = (visaMatrix as any).data;
---

<BaseLayout {title} {description} lang={lang!} {alternateLinks} rtl={isRTL(lang as Lang)}>
  <BreadcrumbNav items={breadcrumbs} lang={lang!} />

  <section class="bg-gradient-to-br from-indigo-900 to-purple-900 text-white py-10">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-2xl md:text-3xl font-bold mb-2">{t('tools.compare_title')}</h1>
      <p class="text-indigo-200">{t('tools.compare_subtitle')}</p>
    </div>
  </section>

  <section class="container mx-auto px-4 py-8">
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Passport 1</label>
          <select id="passport-1" class="w-full px-4 py-3 rounded-xl border focus:ring-2 focus:ring-indigo-300 focus:outline-none">
            <option value="">{t('selector.choose_country')}</option>
            {countryList.map(c => (
              <option value={c.code}>{c.name}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Passport 2</label>
          <select id="passport-2" class="w-full px-4 py-3 rounded-xl border focus:ring-2 focus:ring-indigo-300 focus:outline-none">
            <option value="">{t('selector.choose_country')}</option>
            {countryList.map(c => (
              <option value={c.code}>{c.name}</option>
            ))}
          </select>
        </div>
      </div>

      <div id="compare-results" class="hidden">
        <div class="grid grid-cols-2 gap-4 mb-6" id="compare-stats"></div>
        <div class="bg-white rounded-xl shadow-sm border overflow-hidden" id="compare-table-wrapper">
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-600 text-xs uppercase tracking-wide">
              <tr>
                <th class="px-4 py-3 text-start">{t('table.country')}</th>
                <th class="px-4 py-3 text-center" id="th-p1">Passport 1</th>
                <th class="px-4 py-3 text-center" id="th-p2">Passport 2</th>
              </tr>
            </thead>
            <tbody id="compare-body"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ matrixData, countries, lang }}>
  const statusOrder = { visa_free: 0, visa_on_arrival: 1, e_visa: 2, visa_required: 3 };
  const statusColors = {
    visa_free: 'bg-green-100 text-green-800',
    visa_on_arrival: 'bg-yellow-100 text-yellow-800',
    e_visa: 'bg-blue-100 text-blue-800',
    visa_required: 'bg-red-100 text-red-800',
  };
  const statusLabels = {
    visa_free: 'Visa-Free',
    visa_on_arrival: 'Visa on Arrival',
    e_visa: 'E-Visa',
    visa_required: 'Visa Required',
  };

  function getStats(data) {
    const vals = Object.values(data || {});
    return {
      visa_free: vals.filter(v => v.status === 'visa_free').length,
      visa_on_arrival: vals.filter(v => v.status === 'visa_on_arrival').length,
      e_visa: vals.filter(v => v.status === 'e_visa').length,
      visa_required: vals.filter(v => v.status === 'visa_required').length,
    };
  }

  function compare() {
    const p1 = document.getElementById('passport-1').value;
    const p2 = document.getElementById('passport-2').value;
    if (!p1 || !p2) { document.getElementById('compare-results').classList.add('hidden'); return; }

    const d1 = matrixData[p1] || {};
    const d2 = matrixData[p2] || {};
    const s1 = getStats(d1);
    const s2 = getStats(d2);

    const n1 = countries[p1]?.names?.[lang] || p1;
    const n2 = countries[p2]?.names?.[lang] || p2;
    document.getElementById('th-p1').textContent = n1;
    document.getElementById('th-p2').textContent = n2;

    // Stats
    const statsHtml = `
      <div class="bg-white rounded-xl shadow-sm border p-4">
        <h3 class="font-bold text-gray-900 mb-3">${n1}</h3>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-green-700">Visa-Free</span><span class="font-bold">${s1.visa_free}</span></div>
          <div class="flex justify-between"><span class="text-yellow-700">Visa on Arrival</span><span class="font-bold">${s1.visa_on_arrival}</span></div>
          <div class="flex justify-between"><span class="text-blue-700">E-Visa</span><span class="font-bold">${s1.e_visa}</span></div>
          <div class="flex justify-between"><span class="text-red-700">Visa Required</span><span class="font-bold">${s1.visa_required}</span></div>
        </div>
      </div>
      <div class="bg-white rounded-xl shadow-sm border p-4">
        <h3 class="font-bold text-gray-900 mb-3">${n2}</h3>
        <div class="space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-green-700">Visa-Free</span><span class="font-bold">${s2.visa_free}</span></div>
          <div class="flex justify-between"><span class="text-yellow-700">Visa on Arrival</span><span class="font-bold">${s2.visa_on_arrival}</span></div>
          <div class="flex justify-between"><span class="text-blue-700">E-Visa</span><span class="font-bold">${s2.e_visa}</span></div>
          <div class="flex justify-between"><span class="text-red-700">Visa Required</span><span class="font-bold">${s2.visa_required}</span></div>
        </div>
      </div>`;
    document.getElementById('compare-stats').innerHTML = statsHtml;

    // Table
    const allDests = new Set([...Object.keys(d1), ...Object.keys(d2)]);
    const rows = [...allDests]
      .filter(code => countries[code])
      .map(code => {
        const v1 = d1[code]?.status || 'visa_required';
        const v2 = d2[code]?.status || 'visa_required';
        const name = countries[code]?.names?.[lang] || code;
        const flag = countries[code]?.flag_url || '';
        return { code, name, flag, v1, v2, diff: statusOrder[v1] - statusOrder[v2] };
      })
      .sort((a, b) => a.diff - b.diff);

    document.getElementById('compare-body').innerHTML = rows.map(r => `
      <tr class="border-t hover:bg-gray-50">
        <td class="px-4 py-2 flex items-center gap-2">
          <img src="${r.flag}" class="w-6 h-4 object-cover rounded" alt="${r.name}" />
          <span class="text-sm">${r.name}</span>
        </td>
        <td class="px-4 py-2 text-center"><span class="visa-badge visa-badge-${r.v1} text-xs">${statusLabels[r.v1]}</span></td>
        <td class="px-4 py-2 text-center"><span class="visa-badge visa-badge-${r.v2} text-xs">${statusLabels[r.v2]}</span></td>
      </tr>
    `).join('');

    document.getElementById('compare-results').classList.remove('hidden');
  }

  document.getElementById('passport-1').addEventListener('change', compare);
  document.getElementById('passport-2').addEventListener('change', compare);
</script>
