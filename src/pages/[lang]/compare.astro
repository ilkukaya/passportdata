---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import AdSlot from '../../components/AdSlot.astro';
import Icon from '../../components/Icon.astro';
import { LANG_CODES, getUI, fmt } from '../../i18n';
import { SITE_URL } from '../../config/site';
import { CODES, countryName, countrySlug, homePath, toolPath, alternatesFor, sortByName, hasRoutes } from '../../lib/data';
import { webPage, breadcrumbList } from '../../lib/schema';

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const ui = getUI(lang);
const year = new Date().getUTCFullYear();
const path = toolPath(lang, 'compare');
const url = `${SITE_URL}${path}`;
const title = fmt(ui.compare.title, { year });
const description = ui.compare.description;
const crumbs = [{ name: ui.nav.home, path: homePath(lang) }, { name: ui.nav.compare }];
const sorted = sortByName(CODES, lang);
const names = Object.fromEntries(CODES.map((c) => [c, countryName(c, lang)]));
const slugs = Object.fromEntries(CODES.map((c) => [c, countrySlug(c, lang)]));
const routes = CODES.filter((c) => hasRoutes(lang, c));
const clientData = {
  names,
  status: ui.status,
  str: { onlyFirst: ui.compare.onlyFirst, both: ui.compare.both, loading: ui.compare.loading, error: ui.compare.error, days: ui.common.days },
  lang,
};
const jsonLd = [webPage({ url, name: title, description, lang, crumbs, type: 'WebApplication' }), breadcrumbList(url, crumbs)];
---

<BaseLayout {lang} {title} {description} {path} alternates={alternatesFor((l) => toolPath(l, 'compare'))} {jsonLd}>
  <Breadcrumbs items={crumbs} />
  <section class="wrap mt-5">
    <h1 class="text-3xl md:text-[2.6rem] leading-tight">{ui.compare.h1}</h1>
    <p class="mt-3 max-w-3xl text-lg text-muted">{ui.compare.intro}</p>
  </section>

  <section class="wrap mt-8" id="compare-app">
    <div class="grid items-end gap-3 rounded-xl border border-line bg-surface p-5 sm:p-6 md:grid-cols-[1fr_auto_1fr]">
      {['a', 'b'].map((k, i) => (
        <>
          {i === 1 && (
            <button type="button" id="cmp-swap" class="btn-quiet mx-auto mb-1.5 border border-line" aria-label={ui.common.swap} title={ui.common.swap}><Icon name="swap" size={18} /></button>
          )}
          <label class="block">
            <span class="eyebrow mb-1.5 block">{k === 'a' ? ui.compare.first : ui.compare.second}</span>
            <select id={`pass-${k}`} class="field">
              <option value="">{ui.compare.choose}</option>
              {sorted.map((c) => <option value={c}>{names[c]}</option>)}
            </select>
          </label>
        </>
      ))}
    </div>
    <p id="cmp-status" class="mt-4 text-muted" aria-live="polite"></p>
    <div id="cmp-summary" class="mt-6 grid gap-px overflow-hidden rounded-xl border border-line bg-line empty:hidden md:grid-cols-3"></div>
    <div id="cmp-table-wrap" class="mt-10 hidden">
      <div class="mb-3 flex items-center justify-between gap-4">
        <h2 class="h-section !mb-0">{ui.compare.differences}</h2>
        <label class="flex items-center gap-2 text-sm text-muted"><input type="checkbox" id="cmp-all" class="h-4 w-4 accent-[rgb(var(--brand))]" /> {ui.compare.showAll}</label>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="text-xs text-muted">
            <tr class="border-b border-line"><th scope="col" class="py-3 text-start font-medium">{ui.common.destination}</th><th scope="col" id="th-a" class="py-3 text-start font-medium"></th><th scope="col" id="th-b" class="py-3 text-start font-medium"></th></tr>
          </thead>
          <tbody id="cmp-body"></tbody>
        </table>
      </div>
    </div>
  </section>

  <AdSlot slot="bottom" />

  <script type="application/json" id="cmp-data" set:html={JSON.stringify({ ...clientData, slugs, routes })} />
</BaseLayout>

<script>
  type Req = [string, number?];
  const data = JSON.parse(document.getElementById('cmp-data')!.textContent!);
  const OPEN = new Set(['visa_free', 'visa_on_arrival', 'eta']);
  const ORDER = ['visa_free', 'visa_on_arrival', 'eta', 'e_visa', 'visa_required', 'no_admission'];
  const selA = document.getElementById('pass-a') as HTMLSelectElement;
  const selB = document.getElementById('pass-b') as HTMLSelectElement;
  const statusEl = document.getElementById('cmp-status')!;
  const summary = document.getElementById('cmp-summary')!;
  const wrap = document.getElementById('cmp-table-wrap')!;
  const body = document.getElementById('cmp-body')!;
  const all = document.getElementById('cmp-all') as HTMLInputElement;
  const cache = new Map<string, Record<string, Req>>();
  const collator = new Intl.Collator(data.lang);
  const fill = (t: string, v: Record<string, string>) => t.replace(/\{(\w+)\}/g, (m, k) => v[k] ?? m);

  async function load(code: string) {
    if (!cache.has(code)) {
      const res = await fetch(`/api/v1/passports/${code}.json`);
      if (!res.ok) throw new Error(String(res.status));
      cache.set(code, (await res.json()).requirements);
    }
    return cache.get(code)!;
  }
  const badge = (s: string, days?: number) => {
    const span = document.createElement('span');
    span.className = `badge s-${s}`;
    span.textContent = data.status[s] + (days ? ` · ${fill(data.str.days, { n: String(days) })}` : '');
    return span;
  };
  const flag = (c: string) => {
    const img = document.createElement('img');
    img.src = `/flags/${c.toLowerCase()}.svg`; img.width = 24; img.height = 16; img.alt = ''; img.className = 'flag'; img.loading = 'lazy'; img.width = 21; img.height = 14;
    return img;
  };
  function card(label: string, value: number) {
    const div = document.createElement('div');
    div.className = 'bg-surface p-5';
    div.innerHTML = '<p class="text-sm text-muted"></p><p class="num mt-1 text-3xl font-semibold"></p>';
    div.children[0].textContent = label;
    div.children[1].textContent = String(value);
    return div;
  }

  async function run() {
    const a = selA.value, b = selB.value;
    const params = new URLSearchParams();
    if (a) params.set('a', a);
    if (b) params.set('b', b);
    history.replaceState(null, '', params.toString() ? `?${params}` : location.pathname);
    summary.replaceChildren();
    wrap.classList.add('hidden');
    if (!a || !b || a === b) return;
    statusEl.textContent = data.str.loading;
    try {
      const [ra, rb] = await Promise.all([load(a), load(b)]);
      statusEl.textContent = '';
      document.getElementById('th-a')!.textContent = data.names[a];
      document.getElementById('th-b')!.textContent = data.names[b];
      const dests = Object.keys(data.names).filter((d) => d !== a && d !== b);
      let onlyA = 0, onlyB = 0, both = 0;
      for (const d of dests) {
        const oa = OPEN.has(ra[d]?.[0]), ob = OPEN.has(rb[d]?.[0]);
        if (oa && ob) both++; else if (oa) onlyA++; else if (ob) onlyB++;
      }
      summary.append(
        card(fill(data.str.onlyFirst, { name: data.names[a] }), onlyA),
        card(data.str.both, both),
        card(fill(data.str.onlyFirst, { name: data.names[b] }), onlyB),
      );
      const rows = dests
        .filter((d) => all.checked || ra[d]?.[0] !== rb[d]?.[0])
        .sort((x, y) => ORDER.indexOf(ra[x]?.[0]) - ORDER.indexOf(ra[y]?.[0]) || collator.compare(data.names[x], data.names[y]));
      body.replaceChildren(...rows.map((d) => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-line';
        const td0 = document.createElement('td');
        td0.className = 'py-2.5 pe-3';
        const link = document.createElement('a');
        link.className = 'flex items-center gap-2 font-medium hover:text-brand';
        link.href = pairHref(a, d);
        link.append(flag(d), document.createTextNode(data.names[d]));
        td0.append(link);
        const td1 = document.createElement('td'); td1.className = 'py-2.5 pe-3'; if (ra[d]) td1.append(badge(ra[d][0], ra[d][1]));
        const td2 = document.createElement('td'); td2.className = 'py-2.5'; if (rb[d]) td2.append(badge(rb[d][0], rb[d][1]));
        tr.append(td0, td1, td2);
        return tr;
      }));
      wrap.classList.remove('hidden');
    } catch {
      statusEl.textContent = data.str.error;
    }
  }
  const routes = new Set<string>(data.routes);
  const pairHref = (from: string, to: string) =>
    routes.has(from) ? `/${data.lang}/${data.slugs[from]}/to/${data.slugs[to]}/` : `/${data.lang}/visit/${data.slugs[to]}/`;

  const qs = new URLSearchParams(location.search);
  if (qs.get('a')) selA.value = qs.get('a')!.toUpperCase();
  if (qs.get('b')) selB.value = qs.get('b')!.toUpperCase();
  [selA, selB, all].forEach((el) => el.addEventListener('change', run));
  document.getElementById('cmp-swap')!.addEventListener('click', () => { [selA.value, selB.value] = [selB.value, selA.value]; run(); });
  run();
</script>
