---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Flag from '../../components/Flag.astro';
import AdSlot from '../../components/AdSlot.astro';
import { LANG_CODES, getUI, fmt, num, formatDate } from '../../i18n';
import { SITE_URL } from '../../config/site';
import { RANKING, DATA_UPDATED, countryName, passportPath, homePath, toolPath, alternatesFor, DESTINATION_COUNT } from '../../lib/data';
import { webPage, breadcrumbList, dataset } from '../../lib/schema';

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const ui = getUI(lang);
const year = new Date().getUTCFullYear();
const date = formatDate(lang, DATA_UPDATED);
const path = toolPath(lang, 'passport-ranking');
const url = `${SITE_URL}${path}`;
const title = fmt(ui.ranking.title, { year });
const description = fmt(ui.ranking.description, { date });
const crumbs = [{ name: ui.nav.home, path: homePath(lang) }, { name: ui.nav.ranking }];
const max = RANKING[0].score;
const jsonLd = [
  webPage({ url, name: title, description, lang, crumbs, type: 'CollectionPage' }),
  breadcrumbList(url, crumbs),
  {
    '@type': 'ItemList',
    '@id': `${url}#list`,
    name: title,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: RANKING.length,
    itemListElement: RANKING.slice(0, 50).map((e, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `${countryName(e.code, lang)} (${e.score})`,
      url: `${SITE_URL}${passportPath(lang, e.code)}`,
    })),
  },
  dataset(lang, 'PassportData – global visa requirements', description),
];
---

<BaseLayout {lang} {title} {description} {path} alternates={alternatesFor((l) => toolPath(l, 'passport-ranking'))} {jsonLd}>
  <Breadcrumbs items={crumbs} />
  <section class="wrap mt-4">
    <h1 class="text-3xl md:text-4xl">{fmt(ui.ranking.h1, { year })}</h1>
    <p class="mt-4 text-slate-700 max-w-3xl leading-relaxed" data-answer>{fmt(ui.ranking.intro, { date })}</p>
  </section>

  <AdSlot slot="top" />

  <section class="wrap mt-8">
    <div class="card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-600 text-xs uppercase tracking-wide">
          <tr>
            <th scope="col" class="px-4 py-3 text-start w-16">{ui.common.rank}</th>
            <th scope="col" class="px-4 py-3 text-start">{ui.common.passport}</th>
            <th scope="col" class="px-4 py-3 text-start">{ui.ranking.score}</th>
            <th scope="col" class="px-4 py-3 text-start hidden md:table-cell">{ui.ranking.breakdown}</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {RANKING.map((e) => (
            <tr id={e.code.toLowerCase()} class="hover:bg-slate-50 scroll-mt-20">
              <td class="px-4 py-2.5 font-bold text-slate-700">{e.rank}</td>
              <td class="px-4 py-2.5">
                <a href={passportPath(lang, e.code)} class="flex items-center gap-3 font-medium hover:text-indigo-700">
                  <Flag code={e.code} /><span>{countryName(e.code, lang)}</span>
                </a>
              </td>
              <td class="px-4 py-2.5">
                <div class="flex items-center gap-3">
                  <div class="hidden sm:block w-32 h-2 rounded-full bg-slate-100 overflow-hidden">
                    <div class="h-full bg-indigo-600" style={`width:${Math.round((e.score / max) * 100)}%`}></div>
                  </div>
                  <span class="font-semibold">{num(lang, e.score)}<span class="text-slate-400 font-normal">/{DESTINATION_COUNT}</span></span>
                </div>
              </td>
              <td class="px-4 py-2.5 hidden md:table-cell text-slate-600">
                {num(lang, e.counts.visa_free)} / {num(lang, e.counts.visa_on_arrival)} / {num(lang, e.counts.eta)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <AdSlot slot="bottom" />
</BaseLayout>
