---
import countries from '../../data/countries.json';
import passportRanking from '../../data/passport_ranking.json';
import { SUPPORTED_LANGS, useTranslations, getCountrySlug, getToolPageAlternateLinks, isRTL, type Lang } from '../../utils/i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import AdSenseSlot from '../../components/AdSenseSlot.astro';

export function getStaticPaths() {
  return SUPPORTED_LANGS.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as Lang);
const currentYear = new Date().getFullYear();
const alternateLinks = getToolPageAlternateLinks('passport-ranking');

const title = t('seo.ranking_title', { year: String(currentYear) });
const description = t('seo.ranking_description', { year: String(currentYear) });

const breadcrumbs = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.ranking') },
];

// Sort by rank
const rankings = Object.entries(passportRanking as Record<string, any>)
  .filter(([code]) => (countries as any)[code])
  .sort(([, a], [, b]) => (a.rank || 999) - (b.rank || 999))
  .map(([code, data]) => ({
    code,
    name: (countries as any)[code]?.names?.[lang] || (countries as any)[code]?.names?.en || code,
    flag_url: (countries as any)[code]?.flag_url,
    slug: getCountrySlug(code, lang as Lang, countries),
    rank: data.rank,
    total: data.total,
  }));
---

<BaseLayout {title} {description} lang={lang!} {alternateLinks} rtl={isRTL(lang as Lang)}>
  <BreadcrumbNav items={breadcrumbs} lang={lang!} />

  <section class="bg-gradient-to-br from-purple-900 to-indigo-900 text-white py-10">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-2xl md:text-3xl font-bold mb-2">
        {t('ranking.title', { year: String(currentYear) })}
      </h1>
      <p class="text-purple-200">{t('ranking.subtitle')}</p>
    </div>
  </section>

  <AdSenseSlot slot_id="ADSENSE_SLOT_5" />

  <section class="container mx-auto px-4 py-8">
    <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-gray-600 text-xs uppercase tracking-wide">
            <tr>
              <th class="px-4 py-3 text-start">{t('ranking.rank')}</th>
              <th class="px-4 py-3 text-start">{t('table.flag')}</th>
              <th class="px-4 py-3 text-start">{t('ranking.country')}</th>
              <th class="px-4 py-3 text-start">{t('ranking.visa_free_access')}</th>
            </tr>
          </thead>
          <tbody>
            {rankings.map((entry, i) => (
              <tr class:list={['border-t hover:bg-gray-50 transition-colors', i < 3 ? 'bg-yellow-50/50' : '']}>
                <td class="px-4 py-3 font-bold text-gray-900">
                  {i < 3 ? ['🥇', '🥈', '🥉'][i] : `#${entry.rank}`}
                </td>
                <td class="px-4 py-3">
                  <img src={entry.flag_url} alt={entry.name} class="w-8 h-5 object-cover rounded" loading="lazy" />
                </td>
                <td class="px-4 py-3 font-medium">
                  <a href={`/${lang}/${entry.slug}/`} class="hover:text-indigo-600 transition-colors">
                    {entry.name}
                  </a>
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-2">
                    <div class="flex-1 max-w-[200px] bg-gray-200 rounded-full h-2">
                      <div
                        class="bg-indigo-500 h-2 rounded-full"
                        style={`width: ${Math.min((entry.total / 200) * 100, 100)}%`}
                      ></div>
                    </div>
                    <span class="text-gray-700 font-medium">{entry.total} {t('ranking.destinations')}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>
