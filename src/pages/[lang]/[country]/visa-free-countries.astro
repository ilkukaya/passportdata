---
import visaMatrix from '../../../data/visa_matrix.json';
import countries from '../../../data/countries.json';
import { SUPPORTED_LANGS, useTranslations, getCountrySlug, getAlternateLinks, isRTL, type Lang } from '../../../utils/i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import VisaTable from '../../../components/VisaTable.astro';
import AdSenseSlot from '../../../components/AdSenseSlot.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const lang of SUPPORTED_LANGS) {
    for (const [countryCode, countryData] of Object.entries(countries as Record<string, any>)) {
      const slug = getCountrySlug(countryCode, lang, countries);
      paths.push({
        params: { lang, country: slug },
        props: { countryCode, countryData, lang, visaData: (visaMatrix as any).data[countryCode] || {} },
      });
    }
  }
  return paths;
}

const { countryCode, countryData, lang, visaData } = Astro.props;
const t = useTranslations(lang as Lang);
const countryName = countryData.names?.[lang] || countryData.names?.en || countryCode;
const alternateLinks = getAlternateLinks(countryCode, 'visa-free-countries', countries);
const currentYear = new Date().getFullYear();
const countrySlug = getCountrySlug(countryCode, lang as Lang, countries);
const count = Object.values(visaData).filter((v: any) => v.status === 'visa_free').length;

const title = t('seo.visa_free_title', { country: countryName, year: String(currentYear) });
const description = t('seo.home_description', { country: countryName, year: String(currentYear) });

const breadcrumbs = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: countryName, href: `/${lang}/${countrySlug}/` },
  { label: t('nav.visa_free') },
];
---

<BaseLayout {title} {description} {lang} {alternateLinks} rtl={isRTL(lang as Lang)}>
  <BreadcrumbNav items={breadcrumbs} {lang} />

  <section class="bg-gradient-to-br from-green-800 to-emerald-900 text-white py-10">
    <div class="container mx-auto px-4 text-center">
      <img src={countryData.flag_url} alt={countryName} class="w-16 h-11 mx-auto mb-3 rounded shadow-lg object-cover" />
      <h1 class="text-2xl md:text-3xl font-bold mb-2">{title}</h1>
      <p class="text-green-200">
        {t('category_pages.visa_free_heading', { country: countryName })}
      </p>
      <p class="text-green-300 text-sm mt-2">{t('category_pages.count_label', { count: String(count) })}</p>
    </div>
  </section>

  <AdSenseSlot slot_id="ADSENSE_SLOT_3" />
  <VisaTable {visaData} countries={countries as any} {lang} {countryCode} filterStatus="visa_free" />
  <AffiliateBanner {lang} />
</BaseLayout>
