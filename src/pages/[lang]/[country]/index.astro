---
import visaMatrix from '../../../data/visa_matrix.json';
import countries from '../../../data/countries.json';
import passportRanking from '../../../data/passport_ranking.json';
import { SUPPORTED_LANGS, useTranslations, getCountrySlug, getCountryCodeFromSlug,
         getAlternateLinks, isRTL, getVisaStats, type Lang } from '../../../utils/i18n';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import VisaTable from '../../../components/VisaTable.astro';
import PassportStats from '../../../components/PassportStats.astro';
import AffiliateBanner from '../../../components/AffiliateBanner.astro';
import AdSenseSlot from '../../../components/AdSenseSlot.astro';

export function getStaticPaths() {
  const paths: any[] = [];
  for (const lang of SUPPORTED_LANGS) {
    for (const [countryCode, countryData] of Object.entries(countries as Record<string, any>)) {
      const slug = getCountrySlug(countryCode, lang, countries);
      paths.push({
        params: { lang, country: slug },
        props: {
          countryCode,
          countryData,
          lang,
          visaData: (visaMatrix as any).data[countryCode] || {},
          rank: (passportRanking as any)[countryCode],
        },
      });
    }
  }
  return paths;
}

const { countryCode, countryData, lang, visaData, rank } = Astro.props;
const t = useTranslations(lang as Lang);
const stats = getVisaStats(visaData);
const countryName = countryData.names?.[lang] || countryData.names?.en || countryCode;
const alternateLinks = getAlternateLinks(countryCode, 'home', countries);
const rtl = isRTL(lang as Lang);
const currentYear = new Date().getFullYear();
const countrySlug = getCountrySlug(countryCode, lang as Lang, countries);

const title = t('seo.home_title', { country: countryName, year: String(currentYear) });
const description = t('seo.home_description', { country: countryName, year: String(currentYear) });

const breadcrumbs = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: countryName },
];

const categoryLinks = [
  { key: 'visa_free', label: t('nav.visa_free'), href: `/${lang}/${countrySlug}/visa-free-countries/`, count: stats.visa_free, color: 'text-green-600 bg-green-50 border-green-200' },
  { key: 'visa_on_arrival', label: t('nav.visa_on_arrival'), href: `/${lang}/${countrySlug}/visa-on-arrival/`, count: stats.visa_on_arrival, color: 'text-yellow-600 bg-yellow-50 border-yellow-200' },
  { key: 'e_visa', label: t('nav.e_visa'), href: `/${lang}/${countrySlug}/e-visa/`, count: stats.e_visa, color: 'text-blue-600 bg-blue-50 border-blue-200' },
  { key: 'visa_required', label: t('nav.visa_required'), href: `/${lang}/${countrySlug}/visa-required/`, count: stats.visa_required, color: 'text-red-600 bg-red-50 border-red-200' },
];
---

<BaseLayout {title} {description} {lang} {alternateLinks} {rtl}>
  <BreadcrumbNav items={breadcrumbs} {lang} />

  <!-- Hero -->
  <section class="bg-gradient-to-br from-blue-900 to-indigo-900 text-white py-12">
    <div class="container mx-auto px-4 text-center">
      <img src={countryData.flag_url} alt={countryName} class="w-20 h-14 mx-auto mb-4 rounded shadow-lg object-cover" />
      <h1 class="text-3xl md:text-4xl font-bold mb-2">
        {t('hero.title', { country: countryName })}
      </h1>
      <p class="text-blue-200 text-lg mb-2">
        {t('hero.subtitle', { country: countryName, year: String(currentYear) })}
      </p>
      {rank && (
        <p class="text-blue-300 text-sm">
          {t('hero.henley_rank')}: #{rank.rank} — {t('hero.accessible')}: {rank.total}
        </p>
      )}
    </div>
  </section>

  <!-- Stats -->
  <PassportStats {stats} {lang} {countryCode} />

  <!-- Category Links -->
  <section class="container mx-auto px-4 py-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {categoryLinks.map(cat => (
        <a href={cat.href} class={`block rounded-xl border p-4 text-center hover:shadow-md transition-shadow ${cat.color}`}>
          <div class="text-2xl font-bold">{cat.count}</div>
          <div class="text-sm font-medium mt-1">{cat.label}</div>
        </a>
      ))}
    </div>
  </section>

  <AdSenseSlot slot_id="ADSENSE_SLOT_1" />

  <!-- Visa Table -->
  <VisaTable {visaData} countries={countries as any} {lang} {countryCode} />

  <AdSenseSlot slot_id="ADSENSE_SLOT_2" />

  <!-- Affiliate -->
  <AffiliateBanner {lang} />
</BaseLayout>
