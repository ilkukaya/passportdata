---
import '../styles/global.css';
import { LANGUAGES, getUI, fmt, formatDate, langInfo } from '../i18n';
import {
  SITE_NAME, SITE_URL, ADSENSE_CLIENT, GA4_ID, CF_ANALYTICS_TOKEN, VERIFICATION, AFFILIATES,
} from '../config/site';
import { DATA_UPDATED, homePath, toolPath } from '../lib/data';
import { baseGraph } from '../lib/schema';
import Icon from '../components/Icon.astro';

interface Props {
  lang: string;
  title: string;
  description: string;
  path: string;
  /** Equivalent pages in other languages (used for hreflang). */
  alternates?: Record<string, string>;
  /** Where the language switcher should point (defaults to alternates, then each language's home page). */
  langLinks?: Record<string, string>;
  xDefault?: string;
  jsonLd?: object[];
  noindex?: boolean;
  ogType?: string;
}

const { lang, title, description, path, alternates = {}, langLinks = {}, xDefault, jsonLd = [], noindex = false, ogType = 'website' } =
  Astro.props;
const ui = getUI(lang);
const info = langInfo(lang);
const canonical = `${SITE_URL}${path}`;
const ogImage = `${SITE_URL}/og/${lang}.png`;
const defaultHref = xDefault ?? alternates.en;
const graph = { '@context': 'https://schema.org', '@graph': [...baseGraph(lang, ui.meta.tagline), ...jsonLd] };
const year = new Date().getUTCFullYear();
const hasAffiliates = Object.values(AFFILIATES).some(Boolean);
const EEA = ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH'];
const consentScript = `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied',wait_for_update:500,region:${JSON.stringify(EEA)}});
gtag('consent','default',{ad_storage:'granted',ad_user_data:'granted',ad_personalization:'granted',analytics_storage:'granted'});
gtag('set','ads_data_redaction',true);gtag('js',new Date());${GA4_ID ? `gtag('config','${GA4_ID}');` : ''}`;
const nav = [
  { href: toolPath(lang, 'passport-ranking'), label: ui.nav.ranking },
  { href: toolPath(lang, 'compare'), label: ui.nav.compare },
  { href: toolPath(lang, 'schengen-calculator'), label: ui.nav.schengen },
];
---

<!doctype html>
<html lang={info.hreflang} dir={info.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {Object.entries(alternates).map(([code, href]) => (
      <link rel="alternate" hreflang={langInfo(code).hreflang} href={`${SITE_URL}${href}`} />
    ))}
    {defaultHref && Object.keys(alternates).length > 0 && <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${defaultHref}`} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={info.ogLocale} />
    {Object.keys(alternates).filter((c) => c !== lang).map((c) => <meta property="og:locale:alternate" content={langInfo(c).ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1219" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    {VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
    {VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}
    {VERIFICATION.yandex && <meta name="yandex-verification" content={VERIFICATION.yandex} />}

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />

    {(GA4_ID || ADSENSE_CLIENT) && <script is:inline set:html={consentScript} />}
    {GA4_ID && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4_ID}`} />}
    {ADSENSE_CLIENT && (
      <>
        <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
        <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous" />
      </>
    )}
    {CF_ANALYTICS_TOKEN && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })} />
    )}
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:start-3 focus:top-3 z-50 rounded bg-surface px-3 py-2 shadow-lift">{ui.nav.skip}</a>
    <header class="sticky top-0 z-40 border-b border-line bg-paper/90 backdrop-blur supports-[backdrop-filter]:bg-paper/75">
      <div class="wrap flex h-14 items-center gap-6">
        <a href={homePath(lang)} class="flex items-center gap-2.5 shrink-0" aria-label={SITE_NAME}>
          <img src="/favicon.svg" alt="" width="26" height="26" />
          <span class="font-display text-[1.2rem] font-semibold tracking-tight">Passport<span class="text-brass">Data</span></span>
        </a>
        <nav class="hidden md:flex items-center gap-1 text-sm" aria-label={ui.nav.menu}>
          {nav.map((n) => (
            <a href={n.href} class:list={['rounded-md px-3 py-2 text-muted hover:bg-sunken hover:text-ink', path === n.href && '!text-ink font-semibold']}>{n.label}</a>
          ))}
        </nav>
        <div class="ms-auto flex items-center gap-1">
          <details class="dropdown relative">
            <summary class="btn-quiet" aria-label={ui.nav.language}>
              <Icon name="globe" size={18} />
              <span class="hidden text-sm font-medium sm:inline">{info.name}</span><span class="text-xs font-semibold uppercase sm:hidden">{lang}</span>
            </summary>
            <ul class="menu end-0 w-52 max-h-[70vh] overflow-y-auto">
              {LANGUAGES.map((l) => (
                <li>
                  <a href={langLinks[l.code] ?? alternates[l.code] ?? homePath(l.code)} hreflang={l.hreflang} lang={l.hreflang}
                     class:list={['mlink flex justify-between', l.code === lang && 'font-semibold text-brand']}>
                    <span>{l.name}</span><span class="text-xs uppercase text-faint">{l.code}</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
          <details class="dropdown relative md:hidden">
            <summary class="btn-quiet" aria-label={ui.nav.menu}><Icon name="menu" size={20} /></summary>
            <ul class="menu end-0 w-64">
              {nav.map((n) => <li><a href={n.href} class="mlink">{n.label}</a></li>)}
            </ul>
          </details>
        </div>
      </div>
    </header>

    <main id="main" class="flex-1 pb-8">
      <slot />
    </main>

    <footer class="mt-20 border-t border-line bg-sunken/50 text-sm">
      <div class="wrap grid gap-10 py-12 md:grid-cols-[1.4fr_1fr_1fr]">
        <div>
          <p class="flex items-center gap-2.5">
            <img src="/favicon.svg" alt="" width="26" height="26" loading="lazy" />
            <span class="font-display text-lg font-semibold">Passport<span class="text-brass">Data</span></span>
          </p>
          <p class="mt-3 max-w-sm text-muted">{ui.meta.tagline}. {fmt(ui.footer.dataNote, { date: formatDate(lang, DATA_UPDATED) })}</p>
        </div>
        <div>
          <p class="eyebrow mb-3">{SITE_NAME}</p>
          <ul class="space-y-2">
            {nav.map((n) => <li><a href={n.href} class="text-ink/80 hover:text-ink">{n.label}</a></li>)}
            <li><a href={toolPath(lang, 'about')} class="text-ink/80 hover:text-ink">{ui.footer.about}</a></li>
            <li><a href={toolPath(lang, 'privacy')} class="text-ink/80 hover:text-ink">{ui.footer.privacy}</a></li>
            <li><a href={toolPath(lang, 'terms')} class="text-ink/80 hover:text-ink">{ui.footer.terms}</a></li>
            <li><a href="/api/v1/visa-requirements.json" class="text-ink/80 hover:text-ink">{ui.footer.data}</a></li>
          </ul>
        </div>
        <div>
          <p class="eyebrow mb-3">{ui.nav.language}</p>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
            {LANGUAGES.map((l) => <li><a href={homePath(l.code)} hreflang={l.hreflang} lang={l.hreflang} class="text-ink/80 hover:text-ink">{l.name}</a></li>)}
          </ul>
        </div>
      </div>
      <div class="border-t border-line">
        <div class="wrap space-y-1.5 py-6 text-xs text-muted">
          <p>{ui.footer.disclaimer}</p>
          {hasAffiliates && <p>{ui.footer.affiliate}</p>}
          <p>{fmt(ui.footer.rights, { year })}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
